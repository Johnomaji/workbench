# Copy to .env and fill in. Never commit .env.

# ── Database (PostgreSQL) ────────────────────────────────────────────────
# Pooled connection, used by the running app.
#   Neon:     the "-pooler" host from the dashboard
#   Supabase: the transaction pooler URL (port 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workbench"

# Direct (non-pooled) connection, used by the Prisma CLI for migrations and seeding.
#   Neon:     the host without "-pooler"
#   Supabase: the direct connection URL (port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/workbench"

# ── Auth ─────────────────────────────────────────────────────────────────
# Long random secret used to encrypt session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Needed whenever the app doesn't run on Vercel: when self-hosting, and for
# `npm start` (a production build) on your own machine. `npm run dev` doesn't need it.
# AUTH_TRUST_HOST=true

# Public address of the app, used for links in emails.
# On Vercel you can leave this unset; the production domain is used.
APP_URL="http://localhost:3000"

# ── Email ────────────────────────────────────────────────────────────────
# "console" prints emails in the terminal (development). "resend" sends them.
# Production needs real email: sign-up confirms addresses by email.
EMAIL_PROVIDER="console"
EMAIL_FROM="Workbench <no-reply@example.com>"
RESEND_API_KEY=""

# ── Seed data (development only) ─────────────────────────────────────────
# Password given to every seeded user. The seed refuses to run when NODE_ENV=production.
SEED_PASSWORD="dev-password-123"
# Only to seed a staging database that runs with NODE_ENV=production:
# SEED_ALLOW_PRODUCTION=true

# ── Tests (optional) ─────────────────────────────────────────────────────
# A separate, migrated database. When set, `npm test` also runs the Postgres tests.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workbench_test"
